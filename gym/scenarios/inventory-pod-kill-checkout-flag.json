{
  "name": "inventory-pod-kill-checkout-flag",
  "description": "Every inventory pod is killed once a minute. A checkout flag was turned on a minute before.",
  "paged_service": "frontend",
  "fault": {
    "type": "pod-failure",
    "service": "inventory",
    "schedule": "* * * * *",
    "spec": {
      "podFailure": {
        "percentage": 100,
        "gracePeriodSeconds": 0
      }
    }
  },
  "changes": [
    {
      "name": "checkout-flag",
      "at_seconds": -60,
      "kind": "feature_flag",
      "service": "checkout",
      "flag": "split-shipments",
      "title": "checkout: flag split-shipments turned on"
    }
  ],
  "truth": {
    "service": "inventory",
    "accept": [
      {
        "source": "metric_anomaly",
        "service": "inventory"
      }
    ]
  },
  "group": "held-out"
}
