{
  "name": "checkout-pod-kill-inventory-deploy-after",
  "description": "Every checkout pod is killed once a minute. inventory deploys after the kills have started.",
  "paged_service": "frontend",
  "fault": {
    "type": "pod-failure",
    "service": "checkout",
    "schedule": "* * * * *",
    "spec": {
      "podFailure": {
        "percentage": 100,
        "gracePeriodSeconds": 0
      }
    }
  },
  "changes": [
    {
      "name": "inventory-deploy",
      "at_seconds": 150,
      "kind": "deploy",
      "service": "inventory",
      "title": "inventory v1.9.2: retry reservations"
    }
  ],
  "truth": {
    "service": "checkout",
    "accept": [
      {
        "source": "metric_anomaly",
        "service": "checkout"
      }
    ]
  },
  "group": "held-out"
}
