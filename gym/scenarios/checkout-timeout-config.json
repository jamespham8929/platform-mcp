{
  "name": "checkout-timeout-config",
  "description": "No chaos. A config change sets checkout's upstream timeout to 100us, a slip for 100ms, so almost all its calls to inventory time out. inventory itself stays healthy. An inventory flag was turned on two minutes before.",
  "paged_service": "frontend",
  "changes": [
    {
      "name": "inventory-flag",
      "at_seconds": -120,
      "kind": "feature_flag",
      "service": "inventory",
      "flag": "warehouse-sync",
      "title": "inventory: flag warehouse-sync turned on"
    },
    {
      "name": "timeout-config",
      "at_seconds": 0,
      "kind": "config_change",
      "service": "checkout",
      "title": "checkout: upstream timeout lowered to 100us",
      "set_json": {
        "env": "[{\"name\":\"UPSTREAM_URL\",\"value\":\"http://inventory\"},{\"name\":\"UPSTREAM_TIMEOUT\",\"value\":\"100us\"}]"
      }
    }
  ],
  "truth": {
    "service": "checkout",
    "accept": [
      {
        "change": "timeout-config"
      }
    ]
  },
  "group": "held-out"
}
